<?xml version="1.0" encoding="UTF-8"?>
<schemalist>
    <schema id="org.gnome.shell.extensions.com.github.hermes83.compiz-windows-effect" path="/org/gnome/shell/extensions/com/github/hermes83/compiz-windows-effect/">

        <key type="i" name="last-version">
            <default>-1</default>
            <summary>Last version installed</summary>
            <description/>
        </key>

        <key type="s" name="preset">
			<default>"P"</default>
			<summary>Preset</summary>
			<description/>
		</key>

        <key type="d" name="friction">
            <default>3.5</default>
            <range min="1.0" max="10.0"/>
            <summary>Friction</summary>
            <description/>
        </key>

        <key type="d" name="spring-k">
            <default>3.8</default>
            <range min="1.0" max="10.0"/>
            <summary>Spring k</summary>
            <description/>
        </key>

        <key type="d" name="speedup-factor-divider">
            <default>12.0</default>
            <range min="2.0" max="40.0"/>
            <summary>Speedup Factor</summary>
            <description>Positive animation step divisor. The preferences slider accepts 2 through 40.</description>
        </key>

        <key type="d" name="mass">
            <default>70.0</default>
            <range min="1.0" max="99.0"/>
            <summary>Mass</summary>
            <description/>
        </key>

        <key type="d" name="x-tiles">
            <default>6.0</default>
            <range min="3.0" max="20.0"/>
            <summary>X Tiles</summary>
            <description/>
        </key>

        <key type="d" name="y-tiles">
            <default>6.0</default>
            <range min="3.0" max="20.0"/>
            <summary>Y Tiles</summary>
            <description/>
        </key>

        <key type="b" name="maximize-effect">
            <default>true</default>
            <summary>Maximize effect</summary>
            <description/>
        </key>

        <key type="b" name="resize-effect">
            <default>false</default>
            <summary>Resize effect</summary>
            <description/>
        </key>
    </schema>
</schemalist>