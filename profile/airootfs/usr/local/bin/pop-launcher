#!/usr/bin/env python3
"""Minimal pop-launcher for Pop Shell. JSON lines on stdin and stdout."""

import json
import os
import shutil
import sys
from pathlib import Path


def current_desktops():
    raw = os.environ.get("XDG_CURRENT_DESKTOP", "GNOME")
    parts = [item.strip() for item in raw.split(":") if item.strip()]
    return set(parts) if parts else {"GNOME"}


def application_dirs():
    dirs = []
    seen = set()

    def add(path):
        try:
            key = str(path.resolve())
        except OSError:
            key = str(path)
        if key in seen:
            return
        seen.add(key)
        dirs.append(path)

    data_home = os.environ.get("XDG_DATA_HOME", "").strip()
    if not data_home:
        data_home = str(Path.home() / ".local" / "share")
    add(Path(data_home) / "applications")

    data_dirs = os.environ.get("XDG_DATA_DIRS")
    if data_dirs is None or not data_dirs.strip():
        data_dirs = "/usr/local/share:/usr/share"
    for entry in data_dirs.split(":"):
        if not entry:
            continue
        root = Path(entry)
        add(root / "applications")
        add(root)
    add(Path("/usr/share/applications"))
    return dirs


def _split_semicolon_list(value):
    return [part.strip() for part in (value or "").split(";") if part.strip()]


def parse_desktop(path):
    try:
        text = path.read_text(encoding="utf-8", errors="replace")
    except OSError:
        return None
    name = generic_name = exec_line = try_exec = icon = comment = keywords = None
    only_show_in = not_show_in = None
    entry_type = None
    hidden = False
    no_display = False
    in_entry = False
    for raw in text.splitlines():
        line = raw.strip()
        if not line or line.startswith("#"):
            continue
        if line.startswith("[") and line.endswith("]"):
            in_entry = line == "[Desktop Entry]"
            continue
        if not in_entry or "=" not in line:
            continue
        key, value = line.split("=", 1)
        key = key.strip()
        value = value.strip()
        if key == "Type":
            entry_type = value
        elif key == "Name" and name is None:
            name = value
        elif key == "GenericName" and generic_name is None:
            generic_name = value
        elif key == "Keywords" and keywords is None:
            keywords = value
        elif key == "Exec" and exec_line is None:
            exec_line = value
        elif key == "TryExec" and try_exec is None:
            try_exec = value
        elif key == "Icon" and icon is None:
            icon = value
        elif key == "Comment" and comment is None:
            comment = value
        elif key == "OnlyShowIn" and only_show_in is None:
            only_show_in = value
        elif key == "NotShowIn" and not_show_in is None:
            not_show_in = value
        elif key == "Hidden":
            hidden = value.lower() == "true"
        elif key == "NoDisplay":
            no_display = value.lower() == "true"
    if hidden or no_display or not name or not exec_line:
        return None
    if entry_type not in (None, "Application"):
        return None
    desktops = current_desktops()
    if only_show_in is not None:
        allowed = set(_split_semicolon_list(only_show_in))
        if allowed and desktops.isdisjoint(allowed):
            return None
    if not_show_in is not None:
        excluded = set(_split_semicolon_list(not_show_in))
        if not desktops.isdisjoint(excluded):
            return None
    if try_exec:
        try_path = Path(try_exec)
        if try_path.is_absolute():
            if not (try_path.is_file() and os.access(try_path, os.X_OK)):
                return None
        elif shutil.which(try_exec) is None:
            return None
    kw_list = _split_semicolon_list(keywords)
    search_parts = [
        name,
        generic_name or "",
        " ".join(kw_list),
        comment or "",
        exec_line,
    ]
    return {
        "path": str(path),
        "name": name,
        "generic_name": generic_name or "",
        "keywords": kw_list,
        "exec": exec_line,
        "icon": icon,
        "description": comment if comment else (generic_name if generic_name else exec_line),
        "search_blob": " ".join(part for part in search_parts if part).casefold(),
    }


def desktop_file_id(path, base_dir=None):
    if base_dir is not None:
        try:
            rel = path.relative_to(base_dir)
            parts = list(rel.parts)
            if parts and parts[0] == "applications" and len(parts) > 1:
                parts = parts[1:]
            return "-".join(parts)
        except ValueError:
            pass
    return path.name


def load_apps():
    apps = []
    seen_ids = set()
    for directory in application_dirs():
        if not directory.is_dir():
            continue
        try:
            paths = sorted(directory.rglob("*.desktop"))
        except OSError:
            continue
        for path in paths:
            if not path.is_file():
                continue
            file_id = desktop_file_id(path, directory)
            if file_id in seen_ids:
                continue
            # Record the id before parsing so Hidden=true overrides a later system entry.
            seen_ids.add(file_id)
            item = parse_desktop(path)
            if item is None:
                continue
            apps.append(item)
    apps.sort(key=lambda app: (app["name"].casefold(), app["path"]))
    return apps


def app_matches_query(app, query):
    needle = query.casefold()
    blob = app.get("search_blob")
    if blob is not None:
        return needle in blob
    return needle in app.get("name", "").casefold()


def emit(payload):
    sys.stdout.write(json.dumps(payload) + "\n")
    sys.stdout.flush()


def result_row(index, app):
    icon = {"Name": app["icon"]} if app["icon"] else None
    return {
        "id": index,
        "name": app["name"],
        "description": app["description"],
        "category_icon": None,
        "icon": icon,
        "exec": app["exec"],
    }


def desktop_entry(app):
    return {"DesktopEntry": {"path": app["path"], "gpu_preference": "Default"}}


def main():
    if hasattr(sys.stdout, "reconfigure"):
        sys.stdout.reconfigure(line_buffering=True)
    apps = load_apps()
    current = []
    for line in sys.stdin:
        line = line.strip()
        if not line:
            continue
        try:
            message = json.loads(line)
        except json.JSONDecodeError:
            continue
        if message == "Exit":
            return 0
        if isinstance(message, dict) and "Quit" in message:
            # Item Quit is not process shutdown. Exit is the only shutdown message.
            continue
        if not isinstance(message, dict):
            continue
        if "Search" in message:
            query = str(message.get("Search") or "").casefold()
            if query:
                matched = [app for app in apps if app_matches_query(app, query)]
            else:
                matched = list(apps)
            current = matched
            emit({"Update": [result_row(index, app) for index, app in enumerate(matched)]})
        elif "Activate" in message:
            index = message.get("Activate")
            if isinstance(index, int) and 0 <= index < len(current):
                emit(desktop_entry(current[index]))
        elif "ActivateContext" in message:
            payload = message.get("ActivateContext") or {}
            index = payload.get("id") if isinstance(payload, dict) else None
            if isinstance(index, int) and 0 <= index < len(current):
                emit(desktop_entry(current[index]))
        elif "Complete" in message:
            index = message.get("Complete")
            if isinstance(index, int) and 0 <= index < len(current):
                emit({"Fill": current[index]["name"]})
        elif "Context" in message:
            index = message.get("Context")
            options = []
            if isinstance(index, int) and 0 <= index < len(current):
                options = [{"id": 0, "name": "Launch"}]
            emit({"Context": {"id": index, "options": options}})
        elif "Select" in message:
            continue
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
