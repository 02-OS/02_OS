#!/usr/bin/env python3
"""Refuse unvalidated desktop or installer package/API combinations."""
import argparse
import inspect
import json
from pathlib import Path
import re
import subprocess
import sys


def package_version(root, package):
    result = subprocess.run(["pacman", "--root", str(root), "-Q", package],
                            check=True, text=True, capture_output=True)
    return result.stdout.strip().split()[1].split(":")[-1]


def check(root, installer=False):
    contract = json.loads((root / "usr/local/share/02os/desktop-compatibility.json").read_text())
    if installer:
        version = package_version(root, "archinstall")
        if ".".join(version.split(".")[:2]) != contract["archinstall"]:
            raise ValueError(f"02_OS requires archinstall {contract['archinstall']}, found {version}")
        from archinstall.lib.installer import Installer
        for method, parameters in contract["installer_api"].items():
            actual = getattr(Installer, method, None)
            if not callable(actual) or list(inspect.signature(actual).parameters)[1:] != parameters:
                raise ValueError(f"Unsupported Archinstall API: {method}")
        return {"archinstall": version}
    versions = {package: package_version(root, package) for package in ("gnome-shell", "mutter")}
    major = contract["gnome_major"]
    for package, version in versions.items():
        if re.match(r"\d+", version).group() != major:
            raise ValueError(f"Unsupported {package} {version}; validated GNOME major is {major}")
    directory = root / "usr/share/gnome-shell/extensions"
    for uuid in contract["extensions"]:
        metadata = json.loads((directory / uuid / "metadata.json").read_text())
        if metadata.get("uuid") != uuid or major not in metadata.get("shell-version", []):
            raise ValueError(f"{uuid} does not support GNOME {major}")
    return versions


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--root", type=Path, default=Path("/"))
    parser.add_argument("--installer", action="store_true")
    args = parser.parse_args()
    try:
        print(json.dumps(check(args.root, args.installer), sort_keys=True))
    except (OSError, ValueError, KeyError, IndexError, AttributeError, ImportError,
            subprocess.CalledProcessError) as error:
        print(f"02os-check-desktop: {error}", file=sys.stderr)
        return 1
    return 0


if __name__ == "__main__":
    sys.exit(main())
