# Wrap the verified vendor DEB payload; never execute Debian maintainer scripts.
pkgname=google-chrome
pkgver=0
pkgrel=1
pkgdesc='Google Chrome stable (verified official binary)'
arch=('x86_64')
url='https://www.google.com/chrome/'
license=('custom:chrome')
depends=('alsa-lib' 'at-spi2-core' 'cairo' 'dbus' 'expat' 'gcc-libs' 'glib2'
         'glibc' 'gtk3' 'libcups' 'libdrm' 'libx11' 'libxcb' 'libxcomposite'
         'libxdamage' 'libxext' 'libxfixes' 'libxkbcommon' 'libxrandr'
         'libxshmfence' 'mesa' 'nspr' 'nss' 'pango' 'systemd-libs'
         'vulkan-icd-loader' 'xdg-utils')
optdepends=('libpipewire: screen sharing on Wayland')
provides=('google-chrome-stable')
conflicts=('google-chrome-stable')
options=('!strip' '!debug')
source=('browser.deb')
noextract=('browser.deb')
sha256sums=('REPLACED_BY_VERIFIED_MANIFEST')

prepare() {
  mkdir -p vendor
  bsdtar -xf browser.deb --include 'data.tar.*' -C vendor
  local payload
  payload=(vendor/data.tar.*)
  [[ ${#payload[@]} == 1 && -f ${payload[0]} ]]
  mkdir -p payload
  bsdtar -xf "${payload[0]}" -C payload
}

package() {
  local vendor="${srcdir}/payload"
  [[ -x ${vendor}/opt/google/chrome/google-chrome ]]
  [[ -f ${vendor}/usr/share/applications/google-chrome.desktop ]]
  install -dm755 "${pkgdir}/opt/google" "${pkgdir}/usr/bin" \
    "${pkgdir}/usr/share/applications" "${pkgdir}/usr/share/icons"
  cp -a "${vendor}/opt/google/chrome" "${pkgdir}/opt/google/"
  install -m644 "${vendor}/usr/share/applications/google-chrome.desktop" \
    "${pkgdir}/usr/share/applications/"
  if [[ -d ${vendor}/usr/share/icons/hicolor ]]; then
    cp -a "${vendor}/usr/share/icons/hicolor" "${pkgdir}/usr/share/icons/"
  fi
  local logo size icon_count=0
  for logo in "${vendor}/opt/google/chrome"/product_logo_*.png; do
    [[ -f ${logo} ]] || continue
    size="${logo##*/product_logo_}"
    size="${size%.png}"
    [[ ${size} =~ ^[0-9]+$ ]] || continue
    install -Dm644 "${logo}" "${pkgdir}/usr/share/icons/hicolor/${size}x${size}/apps/google-chrome.png"
    icon_count=$((icon_count + 1))
  done
  [[ ${icon_count} -gt 0 || -d ${vendor}/usr/share/icons/hicolor ]]
  ln -s /opt/google/chrome/google-chrome "${pkgdir}/usr/bin/google-chrome"
  ln -s /opt/google/chrome/google-chrome "${pkgdir}/usr/bin/google-chrome-stable"
  [[ -f ${pkgdir}/opt/google/chrome/chrome-sandbox ]]
  chmod 4755 "${pkgdir}/opt/google/chrome/chrome-sandbox"
}
